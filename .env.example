# Synthetic local values only. Copy this file to .env and never commit .env.
APP_NAME=AI Outreach System
APP_ENVIRONMENT=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

POSTGRES_DB=outreach
POSTGRES_USER=outreach
POSTGRES_PASSWORD=outreach_dev_only
DATABASE_URL=postgresql+asyncpg://outreach:outreach_dev_only@localhost:5432/outreach

# Fail-closed feature flags
DEMO_MODE=true
ALLOW_REAL_EMAIL=false
ALLOW_PUBLICATION=false
ALLOW_EXTERNAL_EXPORT=false
AUTH_REQUIRED=true
AUTH_SESSION_MINUTES=480
AUTH_LOGIN_WINDOW_MINUTES=15
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_COOKIE_SECURE=false

# Mailpit only; no production SMTP credentials belong here.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USE_TLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=outreach@example.test
SMTP_FROM_NAME=AI Outreach System
SMTP_TEST_RECIPIENT=mailpit@example.test
SMTP_TEST_MODE=true

# Gmail production integration is disabled locally by default. Never put OAuth secrets here.
EMAIL_DELIVERY_PROVIDER=smtp
GMAIL_OAUTH_ENABLED=false
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_REDIRECT_URI=https://outreach.shaidigroup.com/auth/gmail/callback
GMAIL_SYNC_ENABLED=false
# Required in addition to ALLOW_REAL_EMAIL=true for real-send API authentication.
DELIVERY_OWNER_TOKEN=
USER_TIMEZONE=Europe/Moscow
AI_REWRITE_PROVIDER=unavailable
OPENAI_REWRITE_MODEL=gpt-5-mini
ALLOW_OWNER_DATA_TO_AI=false
BACKGROUND_WORKER_POLL_SECONDS=5
BACKGROUND_WORKER_MAX_ATTEMPTS=3
