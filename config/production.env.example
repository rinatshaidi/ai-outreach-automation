# Documentation-only placeholders for compose.production.example.yaml.
# Copy values into the selected production secret store. Never commit a populated copy.

POSTGRES_DB=outreach
POSTGRES_USER=replace_in_secret_store
POSTGRES_PASSWORD=replace_in_secret_store

# The application port is bound to loopback; an approved HTTPS/private proxy owns external access.
APP_BIND_PORT=8000
TRUSTED_PROXY_IPS=replace_with_exact_proxy_ip

LOG_LEVEL=INFO
USER_TIMEZONE=Europe/Moscow
AUTH_SESSION_MINUTES=120
AUTH_LOGIN_WINDOW_MINUTES=15
AUTH_LOGIN_MAX_ATTEMPTS=5

# Non-secret OpenAI switches. OPENAI_API_KEY is intentionally absent from this example.
# Store its value only in /etc/ai-outreach-system/production.env on the VPS (mode 0600).
AI_REWRITE_PROVIDER=unavailable
OPENAI_REWRITE_MODEL=gpt-5-mini
ALLOW_OWNER_DATA_TO_AI=false

# Gmail stays fail-closed until Google OAuth is configured by the owner.
# Client secret, refresh token, and token-encryption key are intentionally absent.
EMAIL_DELIVERY_PROVIDER=smtp
GMAIL_OAUTH_ENABLED=false
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_REDIRECT_URI=https://outreach.shaidigroup.com/auth/gmail/callback
GMAIL_SYNC_ENABLED=false
GMAIL_SYNC_INTERVAL_SECONDS=60
GMAIL_SYNC_BATCH_SIZE=25

BACKGROUND_WORKER_POLL_SECONDS=5
BACKGROUND_WORKER_MAX_ATTEMPTS=3
